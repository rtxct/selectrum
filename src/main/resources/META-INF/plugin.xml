<idea-plugin>
    <id>com.selectrum</id>
    <name>Selectrum</name>
    <vendor>selectrum</vendor>
    <description><![CDATA[
        Auto select the JetBrains IDE's color spectrum by the time of the day.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup id="Selectrum" displayType="BALLOON"/>
        <statusBarWidgetFactory id="SelectrumWidget"
                                implementation="com.selectrum.widget.SelectrumStatusBarWidgetFactory"
                                order="after Position"/>
        <postStartupActivity implementation="com.selectrum.Selectrum"/>
    </extensions>

    <actions>
        <group id="Selectrum.Menu" text="Selectrum" popup="true">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <action id="Selectrum.OpenConfig"
                    class="com.selectrum.infrastructure.action.OpenSelectrumConfigAction"
                    text="Open Configuration"
                    description="Open the Selectrum theme schedule configuration file"/>
        </group>
    </actions>
</idea-plugin>